# Slack App credentials — get these from https://api.slack.com/apps

# Bot OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing Secret (from Basic Information)
SLACK_SIGNING_SECRET=your-signing-secret-here

# Neon PostgreSQL connection string — get this from your Neon dashboard
# Format: postgresql://user:password@host/dbname?sslmode=verify-full
# Use sslmode=verify-full for hosted databases (certificate is verified).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full

# Keep-warm ping (production only). Set to this service own /health URL on a
# host that sleeps when idle, e.g. https://your-app.onrender.com/health
# KEEPALIVE_URL=

# Port (3000 is fine for local; Render sets this automatically)
PORT=3000

# Multi-workspace installs only: leave SLACK_BOT_TOKEN unset and fill these in
# instead, then point the app redirect URL at /slack/oauth_redirect
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
